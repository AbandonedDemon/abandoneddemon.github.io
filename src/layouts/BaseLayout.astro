---
import '../styles/global.css';
import ScrollProgress from '../components/ScrollProgress.astro';
import SiteNav from '../components/SiteNav.astro';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  socialImageUrl?: string;
  socialImageAlt?: string;
}

const { title, description, canonicalUrl, socialImageUrl, socialImageAlt } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:type" content="article" />}
    {canonicalUrl && <meta property="og:title" content={title} />}
    {description && canonicalUrl && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
    {socialImageUrl && <meta name="twitter:card" content="summary_large_image" />}
    {socialImageUrl && <meta name="twitter:title" content={title} />}
    {description && socialImageUrl && <meta name="twitter:description" content={description} />}
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,800;1,9..144,300;1,9..144,400&family=JetBrains+Mono:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <ScrollProgress />
    <SiteNav />
    <slot />
    <!-- Cloudflare Web Analytics -->
    <script is:inline defer type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "36b45f05e4c54a30b8f86c149cc01976"}'></script><!-- End Cloudflare Web Analytics -->
  </body>
</html>
